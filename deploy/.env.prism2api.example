# Values used by deploy/docker-compose.prism2api.yml.
# Keep this file private after filling in PRISM_API_KEY.

# Absolute path to the free-astra checkout that contains Dockerfile.
PRISM2API_SOURCE=/Users/damian/Downloads/free-astra-main

# Host directory containing session.json imported from Prism.
PRISM2API_DATA_DIR=/Users/damian/Downloads/free-astra-main/data

# Generate a long random value and use the same value in the Sub2API account.
PRISM_API_KEY=replace-with-a-random-secret-at-least-32-chars

# The upstream image runs as UID/GID 10001. Keep 0:0 if session.json was
# imported by root, or chown the data directory and use 10001:10001.
PRISM2API_UID=0
PRISM2API_GID=0

PRISM_EFFORT=medium
PRISM_TIMEOUT=240
PRISM_CONCURRENCY=1
PRISM_KEEPALIVE=600
PRISM_MAX_TRANSCRIPT=24000
