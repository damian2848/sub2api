# Generate an independent random management secret; never reuse a public API key.
PRISM_MANAGEMENT_KEY=
PRISM_BROWSER_DATA_DIR=./prism-browser-data
PRISM_BROWSER_BIND=127.0.0.1:8319
# Seconds per bootstrap or generation: 30-3600 (default 30 minutes, for long xhigh outputs).
PRISM_REQUEST_TIMEOUT=1800
# Largest request body in bytes: 4096-33554432 (32 MiB). Codex requests with tool schemas are large.
PRISM_BODY_LIMIT=8388608
# Images/PDF/text: count, per-file bytes, and total decoded bytes. Base64 also counts toward PRISM_BODY_LIMIT.
PRISM_MAX_ATTACHMENTS=8
PRISM_MAX_ATTACHMENT_BYTES=10485760
PRISM_MAX_TOTAL_ATTACHMENT_BYTES=20971520
# Characters of conversation history kept per request (the final user message is never cut): 1000-1000000.
PRISM_MAX_TRANSCRIPT_CHARS=32000
PRISM_QUEUE_LIMIT=8
PRISM_MAX_ACCOUNTS=16
# Independent browser contexts per source account: 1-4. Each has its own project.
PRISM_ACCOUNT_CONCURRENCY=2
# Total browser contexts, including initialization and shutdown: 1-1024.
PRISM_MAX_WORKERS=32
# Legacy bucket capacity across workers, probes and retries: 0 disables pacing, not cooldowns.
PRISM_ACCOUNT_START_LIMIT=0
# Legacy refill derivation in seconds: window / capacity when capacity is positive.
PRISM_START_WINDOW_SECONDS=65
# Bucket capacity (0-120); blank defaults to PRISM_ACCOUNT_START_LIMIT, preserving legacy settings.
PRISM_START_BURST=
# Initial seconds per token (0.001-3600); blank derives legacy window / capacity (65 if disabled).
PRISM_START_REFILL_SECONDS=
# Minimum seconds per token (0.001-3600); blank defaults to the initial refill interval.
PRISM_START_REFILL_MIN_SECONDS=
# Maximum adaptive seconds per token (0.001-3600); blank defaults to max(90, initial refill).
PRISM_START_REFILL_MAX_SECONDS=
# Maximum admission wait (0-3600 s); blank defaults to max(15, initial refill); no alternative keeps queueing.
PRISM_START_MAX_WAIT_SECONDS=
# Minimum pause after a refused start (0-600 s), also waiting for a replenished token.
PRISM_START_COOLDOWN_SECONDS=60
# Independent status poll interval: 0 disables, or 250-10000 ms; retries back off after failures.
PRISM_STATUS_POLL_MS=1000
# Estimated prompt cache lifetime (0-3600 s); 0 disables estimated cache reads.
PRISM_PROMPT_CACHE_TTL_SECONDS=600
# One automatic resubmission when Prism's own servers fail (HTTP 5xx) before any text was published:
# 1 to enable (default) or 0 to turn it off; pause before it (0-60 s); longest wait for an idle worker (0-120 s).
PRISM_TRANSIENT_RETRIES=1
PRISM_TRANSIENT_RETRY_DELAY_SECONDS=4
PRISM_TRANSIENT_RETRY_WAIT_SECONDS=15
# Set these on Sub2API, not on the browser container.
PRISM_BROWSER_ENABLED=true
PRISM_BROWSER_BASE_URL=http://prism-browser:8319
# With host-network Sub2API use http://127.0.0.1:8319 instead.
