# Generate an independent random management secret; never reuse a public API key.
PRISM_MANAGEMENT_KEY=
PRISM_BROWSER_DATA_DIR=./prism-browser-data
PRISM_BROWSER_BIND=127.0.0.1:8319
# Seconds per bootstrap or generation: 30-600.
PRISM_REQUEST_TIMEOUT=240
# Largest request body in bytes: 4096-33554432 (32 MiB). Codex requests with tool schemas are large.
PRISM_BODY_LIMIT=8388608
# Characters of conversation history kept per request (the final user message is never cut): 1000-1000000.
PRISM_MAX_TRANSCRIPT_CHARS=32000
PRISM_QUEUE_LIMIT=8
PRISM_MAX_ACCOUNTS=16
# Set these on Sub2API, not on the browser container.
PRISM_BROWSER_ENABLED=true
PRISM_BROWSER_BASE_URL=http://prism-browser:8319
# With host-network Sub2API use http://127.0.0.1:8319 instead.
